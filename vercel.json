{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    {
      "source": "/perrones",
      "destination": "https://perrones.vercel.app/",
      "permanent": false
    },
    {
      "source": "/perrones/:path*",
      "destination": "https://perrones.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/deadzone",
      "destination": "/deadzone/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/deadzone/",
      "destination": "https://deadzone-five-red.vercel.app/index.html"
    },
    {
      "source": "/deadzone/:path+",
      "destination": "https://deadzone-five-red.vercel.app/deadzone/:path+"
    }
  ]
}
