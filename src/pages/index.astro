---
import Base from '../layouts/Base.astro';
import { games } from '../data/games';
---
<Base title="yeyo.games — Minijuegos">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <section class="mb-12">
      <h1 class="font-display text-6xl leading-none text-white sm:text-8xl">Juega <span class="text-accent">ya.</span></h1>
      <p class="mt-4 max-w-xl text-xl text-zinc-400">Minijuegos directo en el navegador, en computadora y celular. Sin instalar nada.</p>
    </section>

    <section aria-label="Catálogo" class="grid gap-6 sm:grid-cols-2">
      {games.map((g) => {
        const live = g.status === 'live';
        return (
          <a
            href={g.href}
            aria-disabled={!live}
            class:list={[
              'group relative flex flex-col gap-3 rounded-xl border border-line bg-panel p-6 transition',
              live ? 'hover:-translate-y-1 hover:border-accent' : 'pointer-events-none opacity-50',
            ]}
            style={`--c:${g.accent}`}
          >
            <div class="h-1.5 w-12 rounded-full" style="background:var(--c)"></div>
            <h2 class="font-display text-4xl text-white">{g.title}</h2>
            <p class="text-lg text-zinc-400">{g.tagline}</p>
            <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
              {g.tags.map((t) => (
                <span class="rounded border border-line px-2 py-0.5 text-sm uppercase tracking-wider text-zinc-400">{t}</span>
              ))}
              {live && <span class="ml-auto font-display text-2xl text-accent group-hover:translate-x-1 transition">Jugar →</span>}
            </div>
          </a>
        );
      })}
    </section>
  </main>
</Base>
