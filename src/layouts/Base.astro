---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'yeyo.games', description = 'Minijuegos para navegador.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0e0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Teko:wght@500;600;700&display=swap" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh">
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="font-display text-3xl tracking-wide text-white">yeyo<span class="text-accent">.games</span></a>
        <span class="text-sm uppercase tracking-widest text-zinc-500">Hub de minijuegos</span>
      </div>
    </header>
    <slot />
    <footer class="mt-16 border-t border-line py-8 text-center text-sm text-zinc-500">
      © {new Date().getFullYear()} yeyo.games
    </footer>
  </body>
</html>
